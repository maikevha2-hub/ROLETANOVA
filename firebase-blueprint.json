{
  "entities": {
    "users": {
      "title": "users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "email", "password", "name", "role"]
    },
    "prizes": {
      "title": "prizes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "probability": { "type": "number" },
        "monthly_limit": { "type": "number" },
