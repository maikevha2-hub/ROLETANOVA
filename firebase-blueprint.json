        "slice_index": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["id", "name", "probability", "is_active"]
    },
    "spins": {
      "title": "spins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "order_id": { "type": "string" },
